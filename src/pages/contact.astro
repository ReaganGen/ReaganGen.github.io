---
import Base from '../layouts/Base.astro';
import { profile, socials } from '../data/profile';
const first = profile.name.split(' ')[0];
const github = socials.find((s) => s.label === 'GitHub');
const scholar = socials.find((s) => s.label === 'Scholar');
---
<Base title="Contact" description={`Send ${profile.name} a message.`}>
  <section class="wrap page">
    <div class="card chat reveal">
      <div class="thread" id="thread" aria-live="polite"></div>
      <form class="bar" id="bar" novalidate>
        <label class="sr-only" for="msg">Your reply</label>
        <input id="msg" autocomplete="off" placeholder="iMessage" />
        <input type="checkbox" name="botcheck" id="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />
        <button type="submit" aria-label="Send" id="send">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
        </button>
      </form>
      <p class="err" id="err" role="alert"></p>
    </div>

    <div class="side">
      <a class="card mini reveal" href={`mailto:${profile.email}`}>
        <div class="who"><b>{profile.name}</b><span class="mono">{profile.email}</span></div>
        <div class="draft mono"><span>To&nbsp;&nbsp;{profile.email}</span><span>Let's chat</span><span class="muted">Say hello</span></div>
        <span class="pill">Email me ↗</span>
      </a>
      <div class="card mini reveal">
        <div class="who"><b>Elsewhere</b><span class="mono">code and papers</span></div>
        <p class="note">Code lives on GitHub. Papers are on Google Scholar.</p>
        <div class="row">
          {github && <a class="pill" href={github.href} target="_blank" rel="noopener">GitHub ↗</a>}
          {scholar && <a class="pill" href={scholar.href} target="_blank" rel="noopener">Scholar ↗</a>}
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ first, avatar: profile.avatar, key: profile.web3formsKey, email: profile.email }}>
  const thread = document.getElementById('thread');
  const bar = document.getElementById('bar');
  const input = document.getElementById('msg');
  const err = document.getElementById('err');
  const answers = {};

  const steps = [
    { key: 'name', ask: () => "what's your name?", placeholder: 'Your name' },
    { key: 'subject', ask: (a) => `nice to meet you, ${a.name} 👋 what would you like to talk about?`, placeholder: 'Collaboration, a role, a paper…' },
    { key: 'email', ask: () => "what's the best email to reach you?", placeholder: 'you@example.com', type: 'email',
      check: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) || 'That email doesn’t look right. Try again.' },
    { key: 'message', ask: () => 'got it. anything else you want to tell me?', placeholder: 'Your message' },
  ];
  let i = -1;

  const esc = (t) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
  const face = avatar ? `<img class="av" src="${avatar}" alt="">` : `<span class="av">${first[0]}</span>`;

  function bubble(text, me = false) {
    thread.querySelectorAll('.delivered').forEach((d) => d.remove());
    const row = document.createElement('div');
    row.className = me ? 'row me' : 'row them';
    row.innerHTML = me
      ? `<div class="b">${esc(text)}</div><span class="delivered">Delivered</span>`
      : `${face}<div><span class="from">${first}</span><div class="b">${text}</div></div>`;
    thread.appendChild(row);
    requestAnimationFrame(() => row.classList.add('in'));
    thread.scrollTop = thread.scrollHeight;
  }

  function typing(then) {
    const t = document.createElement('div');
    t.className = 'row them in';
    t.innerHTML = `${face}<div class="b typing"><i></i><i></i><i></i></div>`;
    thread.appendChild(t);
    setTimeout(() => { t.remove(); then(); }, 700);
  }

  function next() {
    i += 1;
    if (i < steps.length) {
      const s = steps[i];
      typing(() => bubble(esc(s.ask(answers))));
      input.placeholder = s.placeholder;
      input.type = s.type || 'text';
      input.disabled = false;
      input.focus({ preventScroll: true });
      return;
    }
    input.disabled = true;
    input.placeholder = 'Sending…';
    send();
  }

  async function send() {
    if (!key) {
      typing(() => bubble(`thanks! messaging isn't switched on yet, so please email me at <a href="mailto:${email}">${email}</a> 🙏`));
      input.placeholder = 'Not connected yet';
      return;
    }
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: key,
          subject: `Website message: ${answers.subject}`,
          from_name: answers.name,
          name: answers.name,
          email: answers.email,
          topic: answers.subject,
          message: answers.message,
          botcheck: document.getElementById('botcheck').checked,
        }),
      });
      const data = await res.json();
      if (!data.success) throw new Error(data.message);
      typing(() => bubble('thanks, message received. i’ll get back to you soon ✌️'));
      input.placeholder = 'Message sent';
    } catch {
      typing(() => bubble(`hmm, that didn’t go through. could you email me at <a href="mailto:${email}">${email}</a> instead?`));
      input.placeholder = 'Something went wrong';
    }
  }

  bar.addEventListener('submit', (e) => {
    e.preventDefault();
    if (i < 0 || i >= steps.length) return;
    const v = input.value.trim();
    const s = steps[i];
    if (!v) { err.textContent = 'Type a reply first.'; return; }
    const ok = s.check ? s.check(v) : true;
    if (ok !== true) { err.textContent = ok; return; }
    err.textContent = '';
    answers[s.key] = v;
    bubble(v, true);
    input.value = '';
    input.disabled = true;
    setTimeout(next, 350);
  });
  input.addEventListener('input', () => (err.textContent = ''));

  input.disabled = true;
  bubble('want to work together? just want to chat about AI for biology or lab automation? send me a message here.');
  setTimeout(next, 500);
</script>

<style>
  .page { padding-top: 48px; display: flex; flex-direction: column; gap: 14px; }
  .chat { padding: 28px 28px 22px; }
  .thread {
    display: flex; flex-direction: column; gap: 10px;
    min-height: 260px; max-height: 460px;
    overflow-y: auto; scroll-behavior: smooth;
    /* keep the scrollbar out of the bubbles */
    padding: 4px 14px 18px 2px;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--ink) 22%, transparent) transparent;
  }
  .thread::-webkit-scrollbar { width: 8px; }
  .thread::-webkit-scrollbar-track { background: transparent; }
  .thread::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 4px;
  }
  .thread::-webkit-scrollbar-thumb:hover { background: color-mix(in srgb, var(--ink) 30%, transparent); }
  .thread :global(.row) { display: flex; align-items: flex-end; gap: 10px; max-width: 80%; opacity: 0; transform: translateY(6px); transition: opacity 0.3s, transform 0.3s; }
  .thread :global(.row.in) { opacity: 1; transform: none; }
  .thread :global(.row.me) { align-self: flex-end; flex-direction: column; align-items: flex-end; gap: 4px; }
  .thread :global(.av) { width: 34px; height: 34px; border-radius: 50%; flex: none; object-fit: cover; background: var(--inverse-bg); color: var(--inverse-fg); display: inline-flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 500; }
  .thread :global(.from) { display: block; font-size: 11px; color: var(--muted); margin: 0 0 3px 12px; }
  .thread :global(.b) { padding: 9px 14px; border-radius: 20px; font-size: 15px; line-height: 1.4; background: var(--card-2); color: var(--ink); }
  .thread :global(.b a) { color: var(--bubble-me); text-decoration: underline; }
  .thread :global(.row.them .b) { border-bottom-left-radius: 6px; }
  .thread :global(.row.me .b) { background: var(--bubble-me); color: #fff; border-bottom-right-radius: 6px; }
  .thread :global(.delivered) { font-size: 11px; color: var(--muted); }
  .thread :global(.typing) { display: flex; gap: 4px; padding: 13px 14px; }
  .thread :global(.typing i) { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: blink 1s infinite; }
  .thread :global(.typing i:nth-child(2)) { animation-delay: 0.15s; }
  .thread :global(.typing i:nth-child(3)) { animation-delay: 0.3s; }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }

  .bar { display: flex; align-items: center; gap: 8px; border: 1px solid var(--line); background: var(--paper); border-radius: 999px; padding: 5px 5px 5px 16px; }
  .bar input#msg { flex: 1; border: 0; outline: 0; background: transparent; font: inherit; font-size: 15px; color: var(--ink); min-width: 0; padding: 6px 0; }
  .bar input#msg::placeholder { color: var(--muted); }
  .bar button { width: 30px; height: 30px; border-radius: 50%; border: 0; background: var(--bubble-me); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; flex: none; }
  .bar:has(input:disabled) button { background: var(--card-2); color: var(--muted); }
  .bar:focus-within { border-color: var(--muted); }
  .err { min-height: 18px; margin: 8px 0 0 16px; font-size: 13px; color: var(--accent); }

  .side { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .mini { display: flex; flex-direction: column; gap: 16px; }
  .who { display: flex; flex-direction: column; }
  .who b { font-weight: 500; }
  .mono { font-family: var(--sans); font-size: 12px; color: var(--muted); }
  .draft { display: flex; flex-direction: column; gap: 10px; border-left: 2px solid var(--line); padding: 4px 0 4px 14px; border-radius: 0; color: var(--ink-2); }
  .note { margin: 0; font-size: 15px; color: var(--ink-2); flex: 1; }
  .row { display: flex; gap: 8px; flex-wrap: wrap; }
  .mini .pill { justify-content: center; background: var(--paper); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 640px) {
    .side { grid-template-columns: 1fr; }
    .chat { padding: 20px 16px 16px; }
    .thread :global(.row) { max-width: 92%; }
  }
</style>
