---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const words = (post.body ?? '').split(/\s+/).length;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={post.data.title} description={post.data.description} katex>
  <article class="wrap post">
    <header>
      <a class="back mono" href="/blog/">← All posts</a>
      <h1 class="serif">{post.data.title}</h1>
      <p class="desc">{post.data.description}</p>
      <div class="meta mono">{date} · {Math.max(1, Math.round(words / 230))} min read{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
    </header>
    <div class="layout">
      {toc.length > 1 && (
        <nav class="toc mono" aria-label="Contents">
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
        </nav>
      )}
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .post { padding-top: 64px; }
  header { max-width: 660px; margin: 0 auto 40px; }
  .back { font-size: 12px; color: var(--muted); }
  h1 { font-size: clamp(26px, 3.4vw, 36px); font-weight: 500; line-height: 1.12; letter-spacing: -0.025em; margin: 18px 0 12px; }
  .desc { font-size: 17px; color: var(--ink-2); margin: 0 0 16px; }
  .meta { font-size: 12px; color: var(--muted); display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .mono { font-family: var(--sans); }
  .layout { position: relative; }
  .toc { width: 170px; display: flex; flex-direction: column; gap: 8px; font-size: 12px; color: var(--muted); position: sticky; float: left; top: 80px; }
  .toc a:hover { color: var(--accent); }
  @media (max-width: 1100px) { .toc { display: none; } }

  .prose { max-width: 660px; margin: 0 auto; font-size: 16.5px; line-height: 1.75; }
  .prose :global(h2) { font-weight: 500; font-size: 23px; letter-spacing: -0.015em; margin: 2.2em 0 0.5em; scroll-margin-top: 72px; }
  .prose :global(h3) { font-weight: 500; font-size: 18px; margin: 1.8em 0 0.4em; }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .prose :global(strong) { font-weight: 500; }
  .prose :global(blockquote) { margin: 1.5em 0; padding: 0 0 0 20px; border-left: 2px solid var(--line); border-radius: 0; color: var(--ink-2); font-size: 18px; }
  .prose :global(img) { border-radius: var(--radius-md); margin: 1.5em auto; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 3em 0; }
  .prose :global(:not(pre) > code) { font-family: var(--mono); font-size: 0.86em; background: var(--card-2); padding: 2px 6px; border-radius: 5px; }
  .prose :global(pre) { font-family: var(--mono); font-size: 14px; line-height: 1.6; padding: 18px 20px; border-radius: var(--radius-md); overflow-x: auto; border: 1px solid var(--line); }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 15px; margin: 1.5em 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { padding: 8px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  .prose :global(th) { font-family: var(--sans); font-size: 12px; font-weight: 500; color: var(--muted); }
  .prose :global(.katex-display) { overflow-x: auto; overflow-y: hidden; padding: 6px 0; }
  .prose :global(.astro-code) { background-color: var(--card) !important; }
  :global(:root[data-theme='dark']) .prose :global(.astro-code),
  :global(:root[data-theme='dark']) .prose :global(.astro-code span) { color: var(--shiki-dark) !important; background-color: var(--card) !important; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .prose :global(.astro-code),
    :global(:root:not([data-theme='light'])) .prose :global(.astro-code span) { color: var(--shiki-dark) !important; }
  }
  .prose :global(.astro-code span) { background-color: transparent !important; }
</style>
