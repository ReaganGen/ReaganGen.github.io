---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ModelViewer from '../components/ModelViewer.astro';
import ProjectIcon from '../components/ProjectIcon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<Base title="Work" description="Research, agent and lab-automation projects.">
  <section class="wrap head">
    <div class="eyebrow reveal">Work</div>
    <h1 class="serif reveal">Models, agents and machines.</h1>
    <p class="muted reveal">Open a project for the full write-up.</p>
  </section>

  <section class="wrap grid">
    {rendered.map(({ p }, i) => (
      <button
        class:list={['card tile reveal', { 'off-a': i % 3 === 1, 'off-b': i % 3 === 2 }]}
        type="button"
        data-open={p.id}
        id={p.id}
      >
        <span class="mark"><ProjectIcon id={p.id} /></span>
        <span class="meta">
          <span class="eyebrow">{p.data.kind}</span>
          <span class="when">{p.data.venue ?? p.data.status ?? p.data.period}</span>
        </span>
        <span class="name serif">{p.data.title}</span>
        <span class="tagline">{p.data.tagline}</span>
        <span class="more">Details <span aria-hidden="true">↗</span></span>
      </button>
    ))}
  </section>

  {rendered.map(({ p, Content }) => (
    <template data-proj={p.id}>
      <span class="eyebrow">{p.data.kind} · {p.data.period}{p.data.venue && ` · ${p.data.venue}`}{p.data.status && ` · ${p.data.status}`}</span>
      <h2>{p.data.title}</h2>
      <p class="pm-tag">{p.data.tagline}</p>
      {p.data.links.length > 0 && (
        <div class="pm-links">
          {p.data.links.map((l) => <a class="pill" href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
        </div>
      )}
      {p.id === 'lumi-lab' && <div class="pm-media pm-3d"><ModelViewer src="/models/lumi-lab.glb" title="LUMI-lab platform" tag="Hardware · Cell 2026" /></div>}
      {p.id !== 'lumi-lab' && p.data.image && <div class="pm-media"><img src={p.data.image} alt={`${p.data.title} overview figure`} /></div>}
      <div class="pm-body"><Content /></div>
      {p.data.stack.length > 0 && <div class="pm-stack">{p.data.stack.map((t) => <span class="tag">{t}</span>)}</div>}
    </template>
  ))}

  <dialog id="pm" aria-label="Project details">
    <div class="shell card">
      <button id="pm-close" type="button" aria-label="Close">✕</button>
      <div class="scroll" id="pm-slot"></div>
    </div>
  </dialog>
</Base>

<style>
  .head { padding-top: 56px; padding-bottom: 24px; }
  h1 { font-size: clamp(26px, 3.4vw, 34px); font-weight: 500; margin: 10px 0 6px; letter-spacing: -0.03em; line-height: 1.05; }
  .head p { font-size: 14px; margin: 0; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(248px, 1fr)); gap: 14px; padding-bottom: 30px; }
  .tile {
    display: flex; flex-direction: column; align-items: flex-start; gap: 6px;
    text-align: left; cursor: pointer; font: inherit; color: var(--ink-2); scroll-margin-top: 90px;
  }
  .tile:hover { transform: translateY(-2px); }
  .off-a { transform: translateY(16px); }
  .off-b { transform: translateY(7px); }
  .off-a:hover { transform: translateY(14px); }
  .off-b:hover { transform: translateY(5px); }
  .mark { width: 42px; height: 42px; color: var(--icon); margin-bottom: 6px; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; width: 100%; }
  .when { font-size: 11px; color: var(--muted); }
  .name { font-size: 19px; color: var(--ink); }
  .tagline { font-size: 13px; }
  .more { margin-top: 10px; font-size: 12px; color: var(--accent); }

  dialog { border: 0; padding: 0; background: transparent; max-width: none; max-height: none; width: 100%; height: 100%; }
  dialog::backdrop { background: color-mix(in srgb, var(--ink) 28%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  dialog[open] { display: grid; place-items: center; }
  dialog[open] .shell { animation: pop 0.32s cubic-bezier(0.2, 0.9, 0.25, 1); }
  @keyframes pop { from { opacity: 0; transform: scale(0.97) translateY(10px); } }
  .shell { width: min(92vw, 760px); max-height: 86vh; padding: 0; display: flex; }
  .scroll { overflow-y: auto; padding: 30px 32px 32px; width: 100%; }
  #pm-close {
    position: absolute; top: 18px; right: 18px; z-index: 3;
    width: 32px; height: 32px; border: 0; border-radius: 50%; cursor: pointer;
    background: var(--glass); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--glass-rim);
  }
  #pm-close:hover { color: var(--ink); }

  .scroll :global(h2) { font-size: 24px; font-weight: 500; margin: 4px 0 6px; }
  .scroll :global(.pm-tag) { font-size: 15px; color: var(--ink-2); margin: 0 0 14px; max-width: 42em; }
  .scroll :global(.pm-links) { display: flex; flex-wrap: wrap; gap: 8px; }
  .scroll :global(.pm-media) { margin: 20px 0; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: inset 0 0 0 1px var(--line); }
  .scroll :global(.pm-media img) { width: 100%; display: block; }
  .scroll :global(.pm-3d) { background: transparent; height: 340px; box-shadow: none; }
  .scroll :global(.pm-body) { font-size: 15px; color: var(--ink-2); line-height: 1.65; }
  .scroll :global(.pm-body ul) { padding-left: 18px; margin: 0; }
  .scroll :global(.pm-body li) { margin-bottom: 10px; }
  .scroll :global(.pm-body strong) { color: var(--ink); font-weight: 500; }
  .scroll :global(.pm-stack) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }

  @media (max-width: 640px) {
    .off-a, .off-b, .off-a:hover, .off-b:hover { transform: none; }
    .scroll { padding: 24px 20px 26px; }
    .scroll :global(.pm-3d) { height: 260px; }
  }
</style>

<script>
  const dlg = document.getElementById('pm') as HTMLDialogElement;
  const slot = document.getElementById('pm-slot')!;

  function open(id: string) {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-proj="${id}"]`);
    if (!tpl) return;
    slot.replaceChildren(tpl.content.cloneNode(true));
    dlg.showModal();
    slot.scrollTop = 0;
    // Viewers normally mount on scroll; this copy is new, so start it by hand.
    const model = slot.querySelector<HTMLElement>('.model[data-src]');
    if (model) {
      import('../lib/viewer').then(({ mountGLB }) =>
        mountGLB(model, model.dataset.src!).then(() => model.querySelector('.loading')?.remove())
      );
    }
    history.replaceState(null, '', `#${id}`);
  }

  for (const b of document.querySelectorAll<HTMLElement>('[data-open]')) {
    b.addEventListener('click', () => open(b.dataset.open!));
  }
  document.getElementById('pm-close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg.addEventListener('close', () => {
    slot.replaceChildren();
    history.replaceState(null, '', location.pathname);
  });

  // Deep links such as /projects/#molea open that project straight away.
  const hash = decodeURIComponent(location.hash.slice(1));
  if (hash) open(hash);
</script>
