---
// iPadOS-style pointer for the whole site. Position is written straight to a
// transform on the pointer event, with no easing and no per-move DOM work, so
// it stays glued to the mouse.
---
<div id="cursor" aria-hidden="true"></div>

<style>
  #cursor {
    position: fixed;
    inset: auto;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    padding: 0;
    border: 0;
    overflow: visible;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    scale: 1;
    will-change: transform;
    transition: scale 0.13s cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }
  #cursor:popover-open { display: block; }
  :global(html.has-cursor) #cursor { opacity: 1; }
  :global(html.cursor-press) #cursor { scale: 1.45; }
  :global(html.cursor-none) #cursor { opacity: 0; }

  @media (hover: hover) and (pointer: fine) {
    :global(html.has-cursor),
    :global(html.has-cursor *) { cursor: none; }
    /* text still gets a real caret */
    :global(html.has-cursor input),
    :global(html.has-cursor textarea) { cursor: text; }
    /* otherwise dragging a link or image swaps in the system drag cursor */
    :global(html.has-cursor a),
    :global(html.has-cursor img),
    :global(html.has-cursor svg) { -webkit-user-drag: none; user-select: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #cursor { transition: none; }
  }
</style>

<script>
  const dot = document.getElementById('cursor');

  if (dot && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const root = document.documentElement;

    // A modal <dialog> paints in the top layer, above any z-index, so the dot
    // has to live there too. Re-raising keeps it above newly opened ones.
    const raise = () => {
      try { dot.hidePopover(); } catch {}
      try { dot.showPopover(); } catch {}
    };
    if ('showPopover' in dot) {
      dot.setAttribute('popover', 'manual');
      raise();
      new MutationObserver((records) => {
        if (records.some((r) => (r.target as HTMLDialogElement).open)) raise();
      }).observe(document.body, { subtree: true, attributeFilter: ['open'] });
    }

    // Everything past the transform write is guarded, so an ordinary move never
    // touches the class list or walks the tree.
    let shown = false;
    let lastTarget: EventTarget | null = null;
    let overText = false;

    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        dot.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        if (!shown) {
          shown = true;
          root.classList.add('has-cursor');
        }
        if (e.target === lastTarget) return;
        lastTarget = e.target;
        const text = !!(e.target as Element).closest?.('input, textarea');
        if (text !== overText) {
          overText = text;
          root.classList.toggle('cursor-none', text);
        }
      },
      { passive: true }
    );

    addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') root.classList.add('cursor-press');
    });
    const release = () => root.classList.remove('cursor-press');
    addEventListener('pointerup', release);
    addEventListener('pointercancel', release);
    document.addEventListener('mouseleave', () => {
      shown = false;
      root.classList.remove('has-cursor');
    });
    addEventListener('blur', () => {
      release();
      shown = false;
      root.classList.remove('has-cursor');
    });
  }
</script>
