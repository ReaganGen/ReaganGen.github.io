---
// iPadOS-style pointer for the whole site: a soft translucent dot in place of
// the arrow. Position is written straight to a transform with no easing, so it
// tracks the mouse exactly and cannot drift or jitter.
---
<div id="cursor" aria-hidden="true"></div>

<style>
  #cursor {
    position: fixed;
    inset: auto;
    left: 0;
    top: 0;
    padding: 0;
    border: 0;
    overflow: visible;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    will-change: transform;
  }
  #cursor:popover-open { display: block; }
  :global(html.has-cursor) #cursor { opacity: 1; }
  :global(html.cursor-none) #cursor { opacity: 0; }

  @media (hover: hover) and (pointer: fine) {
    :global(html.has-cursor),
    :global(html.has-cursor *) { cursor: none; }
    /* text still gets a real caret */
    :global(html.has-cursor input),
    :global(html.has-cursor textarea) { cursor: text; }
  }
</style>

<script>
  const dot = document.getElementById('cursor');
  const fine = matchMedia('(hover: hover) and (pointer: fine)');

  if (dot && fine.matches) {
    const root = document.documentElement;
    const text = 'input, textarea';

    // A modal <dialog> paints in the top layer, above any z-index, so the dot
    // has to live there too. Re-raising it keeps it above newly opened ones.
    const raise = () => {
      if (!('showPopover' in dot)) return;
      try {
        dot.hidePopover();
      } catch {}
      try {
        dot.showPopover();
      } catch {}
    };
    if ('showPopover' in dot) {
      dot.setAttribute('popover', 'manual');
      raise();
      new MutationObserver((records) => {
        if (records.some((r) => (r.target as HTMLDialogElement).open)) raise();
      }).observe(document.body, { subtree: true, attributeFilter: ['open'] });
    }

    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        dot.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        root.classList.add('has-cursor');
        root.classList.toggle('cursor-none', !!(e.target as Element).closest?.(text));
      },
      { passive: true }
    );

    document.addEventListener('mouseleave', () => root.classList.remove('has-cursor'));
    addEventListener('blur', () => root.classList.remove('has-cursor'));
  }
</script>
