---
// iPadOS-style pointer for the whole site. Position is written straight to a
// transform on the pointer event, with no easing and no per-move DOM work, so
// it stays glued to the mouse.
---
<div id="cursor" aria-hidden="true"></div>

<style>
  #cursor {
    position: fixed;
    inset: auto;
    left: 0;
    top: 0;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    padding: 0;
    border: 0;
    overflow: visible;
    border-radius: 50%;
    background: color-mix(in srgb, var(--ink) 28%, transparent);
    pointer-events: none;
    z-index: 9999;
    opacity: 0;
    will-change: transform;
  }
  #cursor:popover-open { display: block; }
  :global(html.has-cursor) #cursor { opacity: 1; }
  :global(html.cursor-none) #cursor { opacity: 0; }

  @media (hover: hover) and (pointer: fine) {
    :global(html.has-cursor),
    :global(html.has-cursor *) { cursor: none; }
    /* text still gets a real caret */
    :global(html.has-cursor input),
    :global(html.has-cursor textarea) { cursor: text; }
    /* otherwise dragging a link or image swaps in the system drag cursor */
    :global(html.has-cursor a),
    :global(html.has-cursor img),
    :global(html.has-cursor svg) { -webkit-user-drag: none; user-select: none; }
  }
</style>

<script>
  const dot = document.getElementById('cursor');

  if (dot && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const root = document.documentElement;
    let x = -100;
    let y = -100;
    const put = () => {
      dot.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    };

    // Normally the dot is an ordinary fixed element. Only while a modal
    // <dialog> is open does it need the top layer, since a dialog paints above
    // every z-index; staying out of it the rest of the time keeps behaviour
    // plain and predictable.
    const canPop = 'showPopover' in dot;
    let popped = false;
    const anyDialogOpen = () => !!document.querySelector('dialog[open]');
    const sync = () => {
      if (!canPop) return;
      const want = anyDialogOpen();
      if (want === popped) return;
      try {
        if (want) {
          dot.setAttribute('popover', 'manual');
          dot.showPopover();
        } else {
          dot.hidePopover();
          dot.removeAttribute('popover');
        }
        popped = want;
      } catch {}
      put();
    };
    if (canPop) {
      new MutationObserver(sync).observe(document.body, {
        subtree: true,
        attributeFilter: ['open'],
      });
    }

    let shown = false;
    let lastTarget: EventTarget | null = null;
    let overText = false;

    addEventListener(
      'pointermove',
      (e) => {
        if (e.pointerType !== 'mouse') return;
        x = e.clientX;
        y = e.clientY;
        put();
        if (!shown) {
          shown = true;
          root.classList.add('has-cursor');
        }
        if (e.target === lastTarget) return;
        lastTarget = e.target;
        const text = !!(e.target as Element).closest?.('input, textarea');
        if (text !== overText) {
          overText = text;
          root.classList.toggle('cursor-none', text);
        }
      },
      { passive: true }
    );

    // Re-assert on press and release: some browsers disturb the dot mid-click.
    for (const ev of ['pointerdown', 'pointerup', 'pointercancel', 'click'] as const) {
      addEventListener(
        ev,
        (e) => {
          const p = e as PointerEvent;
          if (p.clientX || p.clientY) {
            x = p.clientX;
            y = p.clientY;
          }
          put();
        },
        { passive: true, capture: true }
      );
    }

    const hide = () => {
      shown = false;
      root.classList.remove('has-cursor');
    };
    document.addEventListener('mouseleave', hide);
    addEventListener('blur', hide);
    put();
  }
</script>
