---
import type { CollectionEntry } from 'astro:content';
interface Props { pub: CollectionEntry<'publications'>; compact?: boolean }
const { pub, compact = false } = Astro.props;
const d = pub.data;
// Highlight my name in the author list.
const authors = d.authors.replace(/(Li, G\.[*†]?)/, '<strong>$1</strong>');
---
<li class="pub reveal">
  <div class="venue mono">{d.venue} · {d.year}{d.status && ` · ${d.status}`}</div>
  <div class="title serif">{d.title}</div>
  {!compact && <div class="authors" set:html={authors} />}
  <div class="links">
    {d.role && <span class="tag">{d.role}</span>}
    {d.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>)}
  </div>
</li>

<style>
  .pub { padding: 16px 0; border-top: 1px solid var(--line); }
  .venue { font-family: var(--sans); font-size: 11px; color: var(--accent); letter-spacing: 0.03em; }
  .title { font-size: 16px; line-height: 1.3; margin: 4px 0 6px; }
  .authors { font-size: 12.5px; color: var(--muted); margin-bottom: 8px; }
  .authors :global(strong) { color: var(--ink); font-weight: 500; }
  .links { display: flex; gap: 14px; align-items: center; font-size: 13px; flex-wrap: wrap; }
  .links a { color: var(--ink-2); }
  .links a:hover { color: var(--accent); }
</style>
