---
// Small-molecule viewer. Loads when scrolled into view; click to inspect it full size.
interface Props { src: string; title?: string; tag?: string; height?: string }
const { src, title = 'Molecule', tag, height = '100%' } = Astro.props;
---
<button class="mol" type="button" data-src={src} data-title={title} data-tag={tag} style={`height:${height}`}>
  <span class="hint">Click to expand</span>
</button>

<style>
  .mol {
    position: relative; display: block; width: 100%; min-height: 200px;
    background: none; border: 0; padding: 0; color: inherit; cursor: zoom-in; touch-action: pan-y;
  }
  .hint { position: absolute; right: 2px; bottom: 0; font-size: 11px; color: var(--muted); opacity: 0; transition: opacity 0.25s; pointer-events: none; }
  .mol:hover .hint, .mol:focus-visible .hint { opacity: 1; }
</style>

<script>
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        import('../lib/viewer').then(({ mountSDF }) => mountSDF(el, el.dataset.src!));
      }
    },
    { rootMargin: '200px' }
  );

  for (const el of document.querySelectorAll<HTMLElement>('.mol[data-src]')) {
    io.observe(el);
    let dragged = false;
    el.addEventListener('pointerdown', () => (dragged = false));
    el.addEventListener('pointermove', (e) => { if (e.buttons) dragged = true; });
    el.addEventListener('click', () => {
      if (dragged) return;
      window.dispatchEvent(new CustomEvent('openviewer', {
        detail: { kind: 'sdf', src: el.dataset.src, title: el.dataset.title, tag: el.dataset.tag },
      }));
    });
  }
</script>
