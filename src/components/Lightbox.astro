---
// Floating window for inspecting a model or molecule up close.
---
<dialog id="lb" aria-label="Model viewer">
  <div class="shell card">
    <header>
      <div>
        <span class="eyebrow" id="lb-tag"></span>
        <h2 id="lb-title"></h2>
      </div>
      <div class="acts">
        <button id="lb-replay" type="button" hidden>Replay</button>
        <button id="lb-close" type="button" aria-label="Close">✕</button>
      </div>
    </header>
    <div class="stage" id="lb-stage"></div>
    <p class="hint">Drag to rotate · scroll to zoom · right-drag to pan</p>
  </div>
</dialog>

<style>
  dialog { border: 0; padding: 0; background: transparent; max-width: none; max-height: none; width: 100%; height: 100%; overflow: visible; }
  dialog::backdrop { background: color-mix(in srgb, var(--ink) 28%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  dialog[open] { display: grid; place-items: center; }
  dialog[open] .shell { animation: pop 0.32s cubic-bezier(0.2, 0.9, 0.25, 1); }
  @keyframes pop { from { opacity: 0; transform: scale(0.96) translateY(8px); } }
  .shell { width: min(92vw, 940px); height: min(86vh, 700px); display: flex; flex-direction: column; color: var(--ink-2); }
  header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  h2 { font-size: 20px; font-weight: 500; margin: 2px 0 0; }
  .acts { display: flex; gap: 8px; position: relative; z-index: 2; }
  .acts button {
    border: 0; cursor: pointer; font: inherit; font-size: 13px; color: var(--ink-2);
    background: var(--glass); border-radius: 999px; padding: 6px 14px;
    box-shadow: inset 0 0 0 1px var(--glass-rim);
  }
  .acts button:hover { color: var(--ink); }
  #lb-close { width: 32px; padding: 0; height: 32px; }
  .stage { position: relative; flex: 1; min-height: 0; margin: 10px -12px 0; }
  .stage :global(canvas) { width: 100% !important; height: 100% !important; }
  .hint { font-size: 11px; color: var(--muted); margin: 6px 0 0; text-align: right; }
  @media (max-width: 640px) {
    .shell { width: 94vw; height: 80vh; padding: 20px; }
    .hint { text-align: left; }
  }
</style>

<script>
  import type { mountGLB, mountSDF } from '../lib/viewer';

  const dlg = document.getElementById('lb') as HTMLDialogElement;
  const stage = document.getElementById('lb-stage')!;
  const title = document.getElementById('lb-title')!;
  const tag = document.getElementById('lb-tag')!;
  const replay = document.getElementById('lb-replay') as HTMLButtonElement;
  let live: { dispose(): void; replay?(): void } | null = null;

  async function open(detail: { kind: 'glb' | 'sdf'; src: string; title: string; tag?: string }) {
    title.textContent = detail.title;
    tag.textContent = detail.tag ?? (detail.kind === 'glb' ? 'Hardware' : 'Structure');
    stage.innerHTML = '';
    dlg.showModal();
    const lib = await import('../lib/viewer');
    if (!dlg.open) return;
    live =
      detail.kind === 'glb'
        ? await (lib.mountGLB as typeof mountGLB)(stage, detail.src, { zoom: true, assemble: true })
        : await (lib.mountSDF as typeof mountSDF)(stage, detail.src, { zoom: 1.1, interactive: true });
    replay.hidden = detail.kind !== 'glb';
  }

  function close() {
    live?.dispose();
    live = null;
    stage.innerHTML = '';
  }

  replay.addEventListener('click', () => live?.replay?.());
  document.getElementById('lb-close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('close', close);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  window.addEventListener('openviewer', (e) => open((e as CustomEvent).detail));
</script>
